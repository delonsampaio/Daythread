<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- ── Standard bundle keys (previously auto-injected by GENERATE_INFOPLIST_FILE) ── -->
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>

	<!-- ── UI keys (previously from INFOPLIST_KEY_* build settings) ── -->
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<!-- Launch via storyboard for a fixed-size centered logo. The UILaunchScreen
	     image-dictionary approach scales the image to fill the screen, so the icon
	     appeared full-screen; a storyboard pins the logo to a fixed 120pt box. -->
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>

	<!-- ── EventKit: Apple Calendar sync ── -->
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>Daythread adds your trip events to Apple Calendar so your itinerary appears alongside other appointments.</string>

	<!-- ── CloudKit: background push ──
	     remote-notification lets NSPersistentCloudKitContainer receive silent
	     pushes. (We do NOT declare 'processing'/'fetch': the container manages its
	     own background task identifiers internally, and declaring 'processing'
	     requires BGTaskSchedulerPermittedIdentifiers — which we don't use — and
	     fails App Store validation TMS-90771.) ── -->
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>

	<!-- ── Export compliance ──
	     The app uses only the standard HTTPS/TLS encryption provided by Apple's OS
	     (CloudKit, URLSession) and ships no custom crypto, so it is exempt. Declaring
	     this here skips the App Encryption question on every TestFlight/App Store upload. ── -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>

	<!-- ── CloudKit sharing: required so tapping a CKShare invite link routes
	     to the app and triggers userDidAcceptCloudKitShareWith ── -->
	<key>CKSharingSupported</key>
	<true/>

	<!-- ── Supported orientations ── -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~iPad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
